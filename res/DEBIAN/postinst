#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/rconnect/R-Connect /usr/bin/rconnect
	
	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/rconnect.service ]; then
			rm /etc/systemd/system/rconnect.service /usr/lib/systemd/system/rconnect.service /usr/lib/systemd/user/rconnect.service >/dev/null  2>&1
		fi
		version=$(python3 -V 2>&1 | grep -Po '(?<=Python )(.+)')
		parsedVersion=$(echo "${version//./}")
        mkdir -p /usr/lib/systemd/system/
		cp /usr/share/rconnect/files/systemd/rconnect.service /usr/lib/systemd/system/rconnect.service
		# try fix error in Ubuntu 18.04
		# Failed to reload rconnect.service: Unit rconnect.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/rconnect.service:10: Executable path is not absolute: pkill -f "rconnect --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/rconnect.service
		fi
		systemctl daemon-reload
		systemctl enable rconnect
		systemctl start rconnect
	fi
fi
